{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShadowEncoder",
  "version": "2.1.0",
  "identifier": "com.shadowencoder.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShadowEncoder",
        "width": 1360,
        "height": 820,
        "minWidth": 1200,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
