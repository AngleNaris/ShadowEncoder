{
  "name": "shadowencoder",
  "private": true,
  "version": "2.2.6",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "tsc && vite build",
    "build:cli": "node scripts/stage-agent-cli.mjs",
    "verify:ffmpeg": "node scripts/verify-ffmpeg.mjs",
    "package:windows": "npm run verify:ffmpeg && npm run build:cli && tauri build --features custom-protocol --config src-tauri/tauri.windows.conf.json",
    "package:portable": "npm run package:windows && node scripts/package-portable.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@tauri-apps/api": "^2.0.0",
    "@xyflow/react": "^12.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.5.3",
    "vite": "^6.4.3"
  }
}
